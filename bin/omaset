#!/usr/bin/env luajit

-- omaset CLI entry point.

local function dirname(p)
  local d = p:match("^(.*)/")
  return d or "."
end

local script = arg[0]
if not script:match("^/") then
  local p = io.popen("pwd")
  local cwd = p and p:read("*l")
  if p then p:close() end
  script = (cwd or ".") .. "/" .. script
end

-- Resolve symlinks so the script keeps working when installed via a symlink
-- (e.g. ~/.local/bin/omaset -> <repo>/bin/omaset); otherwise dirname() above
-- would derive the wrong root and the `omaset` module would not be found.
do
  local p = io.popen("readlink -f -- " .. "'" .. script .. "'")
  local resolved = p and p:read("*l")
  if p then p:close() end
  if resolved and resolved ~= "" then script = resolved end
end

local root = dirname(dirname(script))

package.path = root .. "/lib/?.lua;" .. root .. "/lib/?/init.lua;" .. package.path

local omaset = require("omaset")
omaset.bootstrap({
  root = root,
  user_settings_dir = os.getenv("OMASET_SETTINGS_DIR")
    or (os.getenv("HOME") or "") .. "/.config/omaset/settings",
  user_backends_dir = os.getenv("OMASET_BACKENDS_DIR")
    or (os.getenv("HOME") or "") .. "/.config/omaset/backends",
})
omaset.main(arg)
